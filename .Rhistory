set.seed(123)
# Edades observadas (por ejemplo, grupos quinquenales)
age <- seq(0, 80, by = 5)        # 0, 5, 10, ..., 80  (17 edades)
# Puntos donde se evaluarán las curvas estimadas (9 puntos)
xnew <- seq(min(age), max(age), length.out = 9)
xnew
# Años
years <- 1997:2014               # 18 años
years
# Población base por edad (disminuye con la edad)
base_pop <- 20000 * exp(-0.035 * age)
base_pop
# Curva base en escala logit (probabilidad de morir crece con la edad)
logit_base <- -7 + 0.08 * age
logit_base
# Simulamos poblaciones y muertes por año
for (yr in years) {
# Efecto de año: mortalidad baja un poco cada año
year_effect <- -0.015 * (yr - 1997)
# Población para ese año (base + ruido)
pob_year <- round(base_pop * runif(length(age), 0.9, 1.1))
# Probabilidad de morir (logit → prob)
logit_p <- logit_base + year_effect
p_year <- 1 / (1 + exp(-logit_p))
# Muertes simuladas
y_year <- rbinom(length(age), size = pob_year, prob = p_year)
# Guardamos como pob_1997, ..., pob_2014 y y1997, ..., y2014
assign(paste0("pob_", yr), pob_year)
assign(paste0("y", yr), y_year)
}
fits <- list()
for (yr in years) {
pob <- get(paste0("pob_", yr))
y   <- get(paste0("y", yr))
# Modelo logístico: probabilidad de morir según la edad
fit <- glm(cbind(y, pob - y) ~ age, family = binomial)
fits[[as.character(yr)]] <- fit
}
# Cada columna de estim será una curva (año) evaluada en xnew
estim <- matrix(0, nrow = length(xnew), ncol = length(years))
for (j in 1:length(years)) {
yr  <- years[j]
fit <- fits[[as.character(yr)]]
# Predicción de la probabilidad de morir en xnew
est <- predict(fit,
newdata = data.frame(age = xnew),
type   = "response")
estim[, j] <- est
}
colnames(estim) <- years
# Primera curva: año 2011 (posición 15)
estim_ic <- estim[, 1:15]
ord_ic <- extremdepth(estim_ic)
ord_all_ic   <- rep(0, 15)
depth_all_ic <- rep(0, 15)
ord_ic <- extremdepth(estim_ic)
ord_all_ic   <- rep(0, 15)
depth_all_ic <- rep(0, 15)
estim_ic
ord_ic
